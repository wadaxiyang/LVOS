LVOS_APP_ENV=development
LVOS_BIND_ADDR=0.0.0.0:7770
LVOS_DATABASE_URL=sqlite://data/lvos.sqlite3
LVOS_PUBLIC_SERVER_URL=https://lvos.niuniu770.site

LVOS_BOOTSTRAP_DEFAULT_USER=true
LVOS_DEFAULT_USERNAME=default
LVOS_DEFAULT_PASSWORD=change-me-dev

LVOS_ACCESS_TOKEN_TTL_MINUTES=60
LVOS_REFRESH_SESSION_IDLE_TTL_DAYS=90

LVOS_LOGIN_RATE_LIMIT_ENABLED=true
LVOS_MAX_REQUEST_BODY_BYTES=1048576
LVOS_MAX_SYNC_EVENTS_PER_BATCH=500

LVOS_BACKUP_ENABLED=true
LVOS_BACKUP_DIR=./backups
LVOS_BACKUP_RETENTION_COUNT=14

LVOS_UPDATE_CHANNEL=stable

import { Button, ComboBox, LineEdit, Palette, ScrollView, Spinner, Switch } from "std-widgets.slint";

export struct UiRecord {
    key: string,
    source: string,
    translation: string,
    count: int,
    favorite: bool,
    metadata: string,
}

export struct DeviceRecord {
    id: string,
    name: string,
    platform: string,
    last-seen: string,
    current: bool,
    revoked: bool,
}

component IconButton inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    callback activated;
    width: 36px;
    height: 32px;
    border-radius: 8px;
    background: touch.has-hover ? #eef2ff : transparent;

    Text {
        text: root.label;
        color: #4f46e5;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        accessible-role: button;
        accessible-label: root.hint;
        clicked => { root.activated(); }
    }
}

component RecordCard inherits Rectangle {
    in property <UiRecord> item;
    callback favorite-toggled(string);
    height: 104px;
    border-radius: 12px;
    background: #ffffff;
    border-width: 1px;
    border-color: #e5e7eb;

    HorizontalLayout {
        padding: 16px;
        spacing: 14px;
        VerticalLayout {
            spacing: 7px;
            Text { text: item.source; color: #111827; font-size: 16px; font-weight: 600; overflow: elide; }
            Text { text: item.translation; color: #374151; font-size: 14px; overflow: elide; }
            Text {
                text: (item.count > 1 ? "◷  " + item.count : "") + (item.metadata != "" ? "    " + item.metadata : "");
                color: #9ca3af;
                font-size: 12px;
            }
        }
        IconButton {
            label: item.favorite ? "★" : "☆";
            hint: item.favorite ? "Remove from Favorites" : "Add to Favorites";
            activated => { root.favorite-toggled(item.key); }
        }
    }
}

export component QuickLookupPopup inherits Window {
    title: "LVOS Lookup Card";
    width: root.text-mode ? 520px : 360px;
    height: root.text-mode ? 240px : 180px;
    background: transparent;
    always-on-top: true;
    no-frame: true;
    init => { Palette.color-scheme = ColorScheme.light; }

    in property <string> source-text;
    in property <string> translated-text;
    in property <string> error-title;
    in property <string> error-detail;
    in property <int> effective-count;
    in property <bool> favorite;
    in property <bool> loading;
    in property <bool> text-mode;
    in property <bool> error-visible;
    callback favorite-toggled;
    callback refresh-requested;
    callback interaction-started;
    callback dismiss-requested;

    card := Rectangle {
        border-radius: 16px;
        background: #fbfbfe;
        border-width: 1px;
        border-color: #d8dce8;
        drop-shadow-blur: 18px;
        drop-shadow-color: #33000000;
        drop-shadow-offset-y: 6px;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) { root.interaction-started(); }
            }
        }

        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.dismiss-requested();
                    return accept;
                }
                return reject;
            }
        }

        VerticalLayout {
            padding: 18px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.source-text;
                    color: #111827;
                    font-size: root.text-mode ? 15px : 18px;
                    font-weight: 600;
                    wrap: root.text-mode ? word-wrap : no-wrap;
                    overflow: elide;
                }
                IconButton {
                    label: root.favorite ? "★" : "☆";
                    hint: root.favorite ? "Remove from Favorites" : "Add to Favorites";
                    activated => { root.interaction-started(); root.favorite-toggled(); }
                }
            }

            if root.loading: HorizontalLayout {
                alignment: center;
                Spinner { width: 22px; height: 22px; }
                Text { text: "Translating…"; color: #6b7280; }
            }

            if !root.loading && !root.error-visible: Text {
                text: root.translated-text;
                color: #273247;
                font-size: 15px;
                wrap: word-wrap;
                overflow: elide;
            }

            if root.error-visible: Rectangle {
                background: #fff5f5;
                border-radius: 10px;
                height: 66px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;
                    Text { text: root.error-title; color: #991b1b; font-weight: 600; }
                    Text { text: root.error-detail; color: #7f1d1d; font-size: 12px; overflow: elide; }
                }
            }

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: root.effective-count > 1 ? "◷  " + root.effective-count : "";
                    color: #9ca3af;
                    font-size: 12px;
                }
                IconButton {
                    label: "↻";
                    hint: "Refresh translation";
                    activated => { root.interaction-started(); root.refresh-requested(); }
                }
            }
        }
    }
}

export component PermissionWindow inherits Window {
    title: "LVOS Permissions";
    width: 520px;
    height: 300px;
    background: #f8f9fc;
    init => { Palette.color-scheme = ColorScheme.light; }

    in-out property <string> status-text: "Accessibility permission is required.";
    callback open-settings;
    callback check-again;
    callback restart-requested;

    VerticalLayout {
        padding: 32px;
        spacing: 18px;
        Text { text: "Allow LVOS to capture selected text"; color: #111827; font-size: 23px; font-weight: 700; }
        Text {
            text: "macOS requires Accessibility permission before LVOS can send Cmd+C. LVOS only sends it after you press the configured global hotkey.";
            color: #4b5563;
            font-size: 14px;
            wrap: word-wrap;
        }
        Rectangle {
            height: 54px;
            border-radius: 9px;
            background: #fff7ed;
            Text { x: 14px; width: parent.width - 28px; text: root.status-text; color: #9a3412; vertical-alignment: center; wrap: word-wrap; }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 10px;
            Button { text: "Open Accessibility Settings"; clicked => { root.open-settings(); } }
            Button { text: "Check Again"; clicked => { root.check-again(); } }
            Button { text: "Restart LVOS"; clicked => { root.restart-requested(); } }
        }
    }
}

component SidebarButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated;
    height: 42px;
    border-radius: 9px;
    background: selected ? #e0e7ff : touch.has-hover ? #eef2f7 : transparent;
    Text {
        x: 14px;
        width: parent.width - 28px;
        text: root.label;
        color: selected ? #3730a3 : #4b5563;
        font-weight: selected ? 600 : 400;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.activated(); } }
}

component SectionHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 5px;
    Text { text: root.title; color: #111827; font-size: 26px; font-weight: 700; }
    Text { text: root.subtitle; color: #6b7280; font-size: 13px; }
}

component SettingsCard inherits Rectangle {
    in property <string> title;
    height: 190px;
    border-radius: 14px;
    background: #ffffff;
    border-width: 1px;
    border-color: #e5e7eb;
}

export component MainWindow inherits Window {
    title: "LVOS";
    width: 980px;
    height: 680px;
    background: #f6f7fb;
    init => { Palette.color-scheme = ColorScheme.light; }

    in-out property <int> active-page: 0;
    in-out property <int> settings-page: 0;
    in-out property <string> search-text;
    in property <[UiRecord]> history-records;
    in property <[UiRecord]> favorite-records;
    in property <[DeviceRecord]> devices;
    in property <string> primary-provider: "Tencent TokenHub";
    in property <string> fallback-provider: "Google Basic v2";
    in-out property <string> tokenhub-model: "hy-mt2-lite";
    in property <string> server-url: "https://lvos.niuniu770.site";
    in property <string> username;
    in property <string> current-device;
    in property <string> sync-status: "Login required";
    in property <string> update-status: "No update check performed";
    in-out property <string> settings-error;
    in property <bool> tokenhub-configured;
    in property <bool> google-configured;
    in-out property <string> global-hotkey: "⌥D";
    in-out property <bool> start-at-login;
    in-out property <bool> launch-minimized;

    callback history-search(string);
    callback favorites-search(string);
    callback favorite-toggled(string, bool);
    callback clear-history-requested;
    callback validate-provider-settings(string, string, string, string, string) -> string;
    callback persist-provider-settings(string, string, string, string, string);
    callback test-provider(string, string);
    callback login-requested(string, string, string);
    callback logout-requested;
    callback manual-sync-requested;
    callback test-connection-requested;
    callback revoke-device-requested(string);
    callback regenerate-device-identity-requested;
    callback export-data-requested;
    callback import-data-requested;
    callback check-update-requested;
    callback update-global-hotkey(string) -> string;
    callback update-start-at-login(bool) -> string;
    callback update-launch-minimized(bool) -> string;
    HorizontalLayout {
        Rectangle {
            width: 220px;
            background: #eef0f6;
            border-width: 0px;
            VerticalLayout {
                padding: 18px;
                spacing: 7px;
                Text { text: "LVOS"; color: #312e81; font-size: 23px; font-weight: 700; height: 48px; }
                SidebarButton { label: "History"; selected: root.active-page == 0; activated => { root.active-page = 0; } }
                SidebarButton { label: "Favorites"; selected: root.active-page == 1; activated => { root.active-page = 1; } }
                SidebarButton { label: "Settings"; selected: root.active-page == 2; activated => { root.active-page = 2; } }
                Rectangle { vertical-stretch: 1; }
                Text { text: "Local-first desktop"; color: #9ca3af; font-size: 11px; }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: #f8f9fc;

            if root.active-page == 0: VerticalLayout {
                padding: 30px;
                spacing: 18px;
                SectionHeader { title: "History"; subtitle: "Local lookup cache. Nothing here is uploaded."; }
                LineEdit {
                    placeholder-text: "Search English or Chinese…";
                    text <=> root.search-text;
                    edited => { root.history-search(self.text); }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        for item[index] in root.history-records: RecordCard {
                            item: item;
                            favorite-toggled(key) => { root.favorite-toggled(key, item.favorite); }
                        }
                        if root.history-records.length == 0: Text { text: "No History yet."; color: #9ca3af; horizontal-alignment: center; }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button { text: "Clear History"; clicked => { root.clear-history-requested(); } }
                }
            }

            if root.active-page == 1: VerticalLayout {
                padding: 30px;
                spacing: 18px;
                SectionHeader { title: "Favorites"; subtitle: "Independent from History and available offline."; }
                LineEdit {
                    placeholder-text: "Search Favorites…";
                    text <=> root.search-text;
                    edited => { root.favorites-search(self.text); }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        for item[index] in root.favorite-records: RecordCard {
                            item: item;
                            favorite-toggled(key) => { root.favorite-toggled(key, true); }
                        }
                        if root.favorite-records.length == 0: Text { text: "No Favorites yet."; color: #9ca3af; horizontal-alignment: center; }
                    }
                }
            }

            if root.active-page == 2: HorizontalLayout {
                Rectangle {
                    width: 170px;
                    background: #f1f3f8;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 4px;
                        for label[index] in ["General", "Translation", "Account", "Sync", "Devices", "History", "Data", "Update"]: SidebarButton {
                            label: label;
                            selected: root.settings-page == index;
                            activated => { root.settings-page = index; }
                        }
                    }
                }

                ScrollView {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 30px;
                        spacing: 18px;

                        if root.settings-page == 0: VerticalLayout {
                            spacing: 18px;
                            SectionHeader { title: "General"; subtitle: "Desktop behavior and launch preferences."; }
                            SettingsCard {
                                title: "General";
                                VerticalLayout { padding: 18px; spacing: 12px;
                                    Text { text: "Global hotkey"; font-weight: 600; }
                                    hotkey := LineEdit { text <=> root.global-hotkey; }
                                    if root.settings-error != "": Text { text: root.settings-error; color: #b91c1c; }
                                    HorizontalLayout { alignment: end;
                                        Button { text: "Save Hotkey"; clicked => {
                                            root.settings-error = root.update-global-hotkey(hotkey.text);
                                        } }
                                    }
                                    login-start := Switch {
                                        text: "Start at login";
                                        checked <=> root.start-at-login;
                                        toggled => { root.settings-error = root.update-start-at-login(self.checked); }
                                    }
                                    minimized := Switch {
                                        text: "Launch minimized to tray";
                                        checked <=> root.launch-minimized;
                                        toggled => { root.settings-error = root.update-launch-minimized(self.checked); }
                                    }
                                }
                            }
                        }

                        if root.settings-page == 1: VerticalLayout {
                            spacing: 18px;
                            SectionHeader { title: "Translation"; subtitle: "Provider order and user-owned credentials."; }
                            SettingsCard {
                                height: 410px;
                                VerticalLayout { padding: 18px; spacing: 11px;
                                    Text { text: "Primary Provider"; font-weight: 600; }
                                    primary := ComboBox { model: ["Tencent TokenHub", "Google Basic v2"]; current-value: root.primary-provider; }
                                    Text { text: "Fallback Provider"; font-weight: 600; }
                                    fallback := ComboBox { model: ["Google Basic v2", "Tencent TokenHub", "Disabled"]; current-value: root.fallback-provider; }
                                    Text { text: "Tencent TokenHub Model"; font-weight: 600; }
                                    tokenhub-model := LineEdit { text <=> root.tokenhub-model; placeholder-text: "hy-mt2-lite"; }
                                    Text { text: "Tencent TokenHub API Key"; font-weight: 600; }
                                    tokenhub-key := LineEdit { placeholder-text: "Stored in OS Credential Store"; input-type: InputType.password; }
                                    Text { text: "Google Cloud API Key"; font-weight: 600; }
                                    google-key := LineEdit { placeholder-text: "Stored in OS Credential Store"; input-type: InputType.password; }
                                    if root.settings-error != "": Text { text: root.settings-error; color: #b91c1c; }
                                    HorizontalLayout { alignment: end; spacing: 8px;
                                        Button { text: "Test Primary"; clicked => { root.test-provider(primary.current-value, tokenhub-model.text); } }
                                        Button { text: "Save"; clicked => {
                                            root.settings-error = root.validate-provider-settings(primary.current-value, fallback.current-value, tokenhub-model.text, tokenhub-key.text, google-key.text);
                                            if (root.settings-error == "") {
                                                root.persist-provider-settings(primary.current-value, fallback.current-value, tokenhub-model.text, tokenhub-key.text, google-key.text);
                                                tokenhub-key.text = "";
                                                google-key.text = "";
                                            }
                                        } }
                                    }
                                }
                            }
                        }

                        if root.settings-page == 2: VerticalLayout {
                            spacing: 18px;
                            SectionHeader { title: "Account"; subtitle: "Local lookup remains available without login."; }
                            SettingsCard { height: 350px;
                                VerticalLayout { padding: 18px; spacing: 10px;
                                    Text { text: "Server URL"; font-weight: 600; }
                                    server := LineEdit { text: root.server-url; }
                                    Text { text: "Username"; font-weight: 600; }
                                    user := LineEdit { text: root.username; }
                                    Text { text: "Password"; font-weight: 600; }
                                    password := LineEdit { input-type: InputType.password; placeholder-text: "Never stored"; }
                                    HorizontalLayout { alignment: end; spacing: 8px;
                                        Button { text: "Login"; clicked => { root.login-requested(server.text, user.text, password.text); } }
                                        Button { text: "Logout"; clicked => { root.logout-requested(); } }
                                    }
                                    Button { text: "Replace Revoked Device Identity…"; clicked => { root.regenerate-device-identity-requested(); } }
                                }
                            }
                        }

                        if root.settings-page == 3: VerticalLayout {
                            spacing: 18px;
                            SectionHeader { title: "Sync"; subtitle: "Account-specific synchronization diagnostics."; }
                            SettingsCard { height: 250px;
                                VerticalLayout { padding: 18px; spacing: 12px;
                                    Text { text: "Status    " + root.sync-status; font-weight: 600; }
                                    Text { text: "Server    " + root.server-url; color: #6b7280; }
                                    Text { text: "Current Device    " + root.current-device; color: #6b7280; }
                                    HorizontalLayout { spacing: 8px;
                                        Button { text: "Manual Sync"; clicked => { root.manual-sync-requested(); } }
                                        Button { text: "Test Connection"; clicked => { root.test-connection-requested(); } }
                                    }
                                }
                            }
                        }

                        if root.settings-page == 4: VerticalLayout {
                            spacing: 18px;
                            SectionHeader { title: "Devices"; subtitle: "Revoke other installations or inspect status."; }
                            for device[index] in root.devices: Rectangle {
                                height: 82px; background: #ffffff; border-radius: 12px; border-width: 1px; border-color: #e5e7eb;
                                HorizontalLayout { padding: 14px; spacing: 12px;
                                    VerticalLayout { Text { text: device.name + (device.current ? "  Current" : ""); font-weight: 600; } Text { text: device.platform + " · " + device.last-seen; color: #6b7280; } }
                                    Button { text: device.revoked ? "Revoked" : "Revoke"; enabled: !device.revoked; clicked => { root.revoke-device-requested(device.id); } }
                                }
                            }
                        }

                        if root.settings-page == 5: VerticalLayout {
                            spacing: 18px;
                            SectionHeader { title: "History"; subtitle: "History is retained until you explicitly clear it."; }
                            SettingsCard { height: 150px; VerticalLayout { padding: 18px; spacing: 14px; Text { text: "Clear local History cache"; font-weight: 600; } Text { text: "Favorites and their learning statistics are preserved."; color: #6b7280; } Button { text: "Clear History"; clicked => { root.clear-history-requested(); } } } }
                        }

                        if root.settings-page == 6: VerticalLayout {
                            spacing: 18px;
                            SectionHeader { title: "Data"; subtitle: "Portable data excludes credentials and installation identity."; }
                            SettingsCard { height: 160px; VerticalLayout { padding: 18px; spacing: 12px; Button { text: "Export Data"; clicked => { root.export-data-requested(); } } Button { text: "Import Data"; clicked => { root.import-data-requested(); } } } }
                        }

                        if root.settings-page == 7: VerticalLayout {
                            spacing: 18px;
                            SectionHeader { title: "Update"; subtitle: "Unsigned releases are downloaded manually from GitHub Releases."; }
                            SettingsCard { height: 160px; VerticalLayout { padding: 18px; spacing: 12px; Text { text: root.update-status; color: #4b5563; } Button { text: "Check for Updates"; clicked => { root.check-update-requested(); } } } }
                        }
                    }
                }
            }
        }
    }
}

import { Button, ComboBox, LineEdit, Palette, ScrollView, Spinner, Switch } from "std-widgets.slint";

export struct UiRecord {
    key: string,
    source: string,
    translation: string,
    count: int,
    favorite: bool,
    metadata: string,
}

export struct DeviceRecord {
    id: string,
    name: string,
    platform: string,
    last-seen: string,
    current: bool,
    revoked: bool,
}

component SvgIconButton inherits Rectangle {
    in property <image> icon;
    in property <string> hint;
    in property <color> icon-color: #475569;
    callback activated;
    width: 36px;
    height: 34px;
    border-radius: 5px;
    background: svg-touch.pressed ? #d7e7f7 : svg-touch.has-hover ? #e8f1f8 : transparent;

    Image {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.icon-color;
        image-fit: contain;
    }
    svg-touch := TouchArea {
        accessible-role: button;
        accessible-label: root.hint;
        clicked => { root.activated(); }
    }
}

component IconSlot inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: #667085;
    in property <length> icon-size: 18px;
    width: 24px;
    height: 24px;
    background: transparent;

    Image {
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.icon-color;
        image-fit: contain;
    }
}

component RecordCard inherits Rectangle {
    in property <UiRecord> item;
    callback favorite-toggled(string);
    height: 84px;
    border-radius: 8px;
    background: record-touch.has-hover ? #f7fbff : #ffffff;
    border-width: 1px;
    border-color: record-touch.has-hover ? #b8d8f2 : #e1e4e8;

    record-touch := TouchArea { }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 12px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 14px;
        Rectangle {
            width: 36px;
            height: 66px;
            background: transparent;
            Rectangle {
                width: 36px;
                height: 36px;
                y: (parent.height - self.height) / 2;
                border-radius: 8px;
                background: #e9f3fb;
                Text {
                    text: "Aa";
                    color: #0067c0;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            spacing: 5px;
            Text { text: item.source; color: #202020; font-size: 15px; font-weight: 600; overflow: elide; }
            Text { text: item.translation; color: #515151; font-size: 13px; overflow: elide; }
            Text {
                text: (item.count > 1 ? item.count + " lookups" : "1 lookup") + (item.metadata != "" ? "   ·   " + item.metadata : "");
                color: #808080;
                font-size: 11px;
            }
        }
        SvgIconButton {
            icon: item.favorite ? @image-url("icons/star-filled.svg") : @image-url("icons/star.svg");
            icon-color: item.favorite ? #d97706 : #667085;
            hint: item.favorite ? "Remove from Favorites" : "Add to Favorites";
            activated => { root.favorite-toggled(item.key); }
        }
    }
}

export component QuickLookupPopup inherits Window {
    title: "LVOS Lookup Card";
    icon: @image-url("icons/logo.svg");
    width: root.popup-width;
    height: root.popup-height;
    background: transparent;
    always-on-top: true;
    no-frame: true;
    init => { Palette.color-scheme = ColorScheme.light; }

    in property <string> source-text;
    in property <string> translated-text;
    in property <string> error-title;
    in property <string> error-detail;
    in property <int> effective-count;
    in property <bool> favorite;
    in property <bool> loading;
    in property <bool> text-mode;
    in property <bool> error-visible;
    in property <length> popup-width: 360px;
    in property <length> popup-height: 180px;
    callback favorite-toggled;
    callback refresh-requested;
    callback interaction-started;
    callback dismiss-requested;

    card := Rectangle {
        border-radius: 8px;
        background: #ffffff;
        border-width: 1px;
        border-color: #d9d9d9;
        drop-shadow-blur: 12px;
        drop-shadow-color: #26000000;
        drop-shadow-offset-y: 4px;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) { root.interaction-started(); }
            }
        }

        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.dismiss-requested();
                    return accept;
                }
                return reject;
            }
        }

        VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: 52px;
                background: transparent;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 8px;
                    IconSlot {
                        width: 24px;
                        height: 50px;
                        icon: @image-url("icons/translate.svg");
                        icon-size: 18px;
                        icon-color: #0067c0;
                    }
                    VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 7px;
                        spacing: 1px;
                        Text {
                            text: root.source-text;
                            color: #202020;
                            font-size: 15px;
                            font-weight: 600;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                        Text {
                            text: "QUICK LOOKUP";
                            color: #707070;
                            font-size: 9px;
                            letter-spacing: 0.7px;
                        }
                    }
                    SvgIconButton {
                        width: 36px;
                        height: 50px;
                        icon: root.favorite ? @image-url("icons/star-filled.svg") : @image-url("icons/star.svg");
                        icon-color: root.favorite ? #d97706 : #667085;
                        hint: root.favorite ? "Remove from Favorites" : "Add to Favorites";
                        activated => { root.interaction-started(); root.favorite-toggled(); }
                    }
                }
            }

            Rectangle { height: 1px; background: #ececec; }

            Rectangle {
                vertical-stretch: 1;
                background: #ffffff;

                if root.loading: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    Spinner { width: 22px; height: 100%; }
                    Text { text: "Translating…"; color: #5f5f5f; vertical-alignment: center; }
                }

                if !root.loading && !root.error-visible: ScrollView {
                    x: 16px;
                    y: 13px;
                    width: parent.width - 32px;
                    height: parent.height - 24px;
                    horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
                    VerticalLayout {
                        width: parent.width;
                        Text {
                            text: root.translated-text;
                            color: #323130;
                            width: parent.width;
                            font-size: 15px;
                            wrap: word-wrap;
                            overflow: clip;
                        }
                    }
                }

                if root.error-visible: Rectangle {
                    x: 14px;
                    y: 10px;
                    width: parent.width - 28px;
                    height: parent.height - 18px;
                    background: #fff4f4;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #f1c7c7;
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 7px;
                        spacing: 3px;
                        Text { text: root.error-title; color: #a4262c; font-size: 12px; font-weight: 600; }
                        Text { text: root.error-detail; color: #6e2c2c; font-size: 11px; overflow: elide; }
                    }
                }
            }

            Rectangle { height: 1px; background: #ececec; }

            Rectangle {
                height: 41px;
                background: #fafafa;
                VerticalLayout {
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 8px;
                        alignment: space-between;
                        if root.effective-count > 1: HorizontalLayout {
                            spacing: 6px;
                            IconSlot {
                                width: 16px;
                                height: 39px;
                                icon: @image-url("icons/history.svg");
                                icon-size: 14px;
                                icon-color: #777777;
                            }
                            Text {
                                text: root.effective-count + " lookups";
                                color: #707070;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                        SvgIconButton {
                            width: 36px;
                            height: 39px;
                            icon: @image-url("icons/refresh.svg");
                            icon-color: #0067c0;
                            hint: "Refresh translation";
                            activated => { root.interaction-started(); root.refresh-requested(); }
                        }
                    }
                }
            }
        }
    }
}

export component PermissionWindow inherits Window {
    title: "LVOS Permissions";
    icon: @image-url("icons/logo.svg");
    width: 520px;
    height: 300px;
    background: #f8f9fc;
    init => { Palette.color-scheme = ColorScheme.light; }

    in-out property <string> status-text: "Accessibility permission is required.";
    callback open-settings;
    callback check-again;
    callback restart-requested;

    VerticalLayout {
        padding: 32px;
        spacing: 18px;
        Text { text: "Allow LVOS to capture selected text"; color: #111827; font-size: 23px; font-weight: 700; }
        Text {
            text: "macOS requires Accessibility permission before LVOS can send Cmd+C. LVOS only sends it after you press the configured global hotkey.";
            color: #4b5563;
            font-size: 14px;
            wrap: word-wrap;
        }
        Rectangle {
            height: 54px;
            border-radius: 9px;
            background: #fff7ed;
            Text { x: 14px; width: parent.width - 28px; text: root.status-text; color: #9a3412; vertical-alignment: center; wrap: word-wrap; }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 10px;
            Button { text: "Open Accessibility Settings"; clicked => { root.open-settings(); } }
            Button { text: "Check Again"; clicked => { root.check-again(); } }
            Button { text: "Restart LVOS"; clicked => { root.restart-requested(); } }
        }
    }
}

component FluentSidebarItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    in property <bool> collapsed;
    in property <color> accent: #0067c0;
    callback activated;
    height: 40px;
    border-radius: 5px;
    background: selected ? #e5e5e5 : nav-touch.has-hover ? #ebebeb : transparent;

    if selected: Rectangle {
        x: 0px;
        y: 9px;
        width: 3px;
        height: 22px;
        border-radius: 2px;
        background: root.accent;
    }
    HorizontalLayout {
        padding-left: 13px;
        padding-right: 10px;
        spacing: 12px;
        IconSlot {
            height: 40px;
            icon: root.icon;
            icon-size: 20px;
            icon-color: root.selected || nav-touch.has-hover ? root.accent : #5f6368;
        }
        if !root.collapsed: Text {
            text: root.label;
            color: root.selected ? #1f1f1f : #5f5f5f;
            font-size: 14px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    nav-touch := TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.activated(); }
    }
}

component SettingsSidebarItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    callback activated;
    height: 38px;
    border-radius: 5px;
    background: selected ? #e5f1fb : settings-touch.has-hover ? #f0f0f0 : transparent;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 9px;
        spacing: 9px;
        IconSlot {
            width: 20px;
            height: 38px;
            icon: root.icon;
            icon-size: 17px;
            icon-color: root.selected ? #0067c0 : #667085;
        }
        Text {
            text: root.label;
            color: root.selected ? #005a9e : #505050;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
    }
    settings-touch := TouchArea { clicked => { root.activated(); } }
}

component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    height: 48px;
    vertical-stretch: 0;
    spacing: 4px;
    Text { text: root.title; color: #202020; font-size: 24px; font-weight: 600; }
    Text { text: root.subtitle; color: #6b6b6b; font-size: 12px; }
}

component FluentCard inherits Rectangle {
    in property <length> card-height: 190px;
    height: card-height;
    border-radius: 8px;
    background: #ffffff;
    border-width: 1px;
    border-color: #e1e4e8;
}

component SearchBox inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    height: 38px;
    border-radius: 5px;
    background: #ffffff;
    border-width: 1px;
    border-color: search-input.has-focus ? #0067c0 : #d7d7d7;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        IconSlot {
            width: 20px;
            height: 38px;
            icon: @image-url("icons/search.svg");
            icon-size: 17px;
            icon-color: #6b7280;
        }
        search-input := LineEdit {
            text <=> root.text;
            placeholder-text: root.placeholder;
            edited => { root.edited(self.text); }
        }
    }
}

component ToolbarButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> danger: false;
    callback activated;
    width: 132px;
    height: 36px;
    border-radius: 5px;
    background: toolbar-touch.pressed ? (danger ? #f9dddd : #dcecf8) : toolbar-touch.has-hover ? (danger ? #fff0f0 : #eef6fc) : #ffffff;
    border-width: 1px;
    border-color: danger ? #e6b8b8 : #d4d7da;
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        IconSlot { width: 18px; height: 36px; icon: root.icon; icon-size: 16px; icon-color: root.danger ? #c42b1c : #4f5b66; }
        Text { text: root.label; color: root.danger ? #a4262c : #323130; font-size: 12px; vertical-alignment: center; }
    }
    toolbar-touch := TouchArea { clicked => { root.activated(); } }
}

component StatusChip inherits Rectangle {
    in property <string> text;
    in property <bool> good: false;
    width: chip-label.preferred-width + 22px;
    height: 26px;
    border-radius: 13px;
    background: good ? #e8f5ed : #f2f2f2;
    chip-label := Text {
        text: root.text;
        color: root.good ? #107c10 : #616161;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component MainWindow inherits Window {
    title: "LVOS";
    icon: @image-url("icons/logo.svg");
    width: 960px;
    height: 640px;
    background: #f3f3f3;
    init => { Palette.color-scheme = ColorScheme.light; }

    in-out property <int> active-page: 0;
    in-out property <int> settings-page: 0;
    in-out property <bool> sidebar-collapsed: false;
    in-out property <string> search-text;
    in property <[UiRecord]> history-records;
    in property <[UiRecord]> favorite-records;
    in property <[DeviceRecord]> devices;
    in-out property <string> tokenhub-model: "hy-mt2-lite";
    in-out property <int> proxy-kind: 0;
    in-out property <string> proxy-address;
    in-out property <bool> provider-proxy-enabled: false;
    in-out property <bool> update-proxy-enabled: false;
    in property <string> server-url: "https://lvos.niuniu770.site";
    in property <string> username;
    in property <string> current-device;
    in property <string> sync-status: "Login required";
    in property <string> update-status: "No update check performed";
    in-out property <string> settings-error;
    in property <bool> tokenhub-configured;
    in-out property <string> global-hotkey: "⌥D";
    in-out property <bool> start-at-login;
    in-out property <bool> launch-minimized;

    callback history-search(string);
    callback favorites-search(string);
    callback favorite-toggled(string, bool);
    callback clear-history-requested;
    callback validate-provider-settings(string, string) -> string;
    callback persist-provider-settings(string, string, bool);
    callback persist-network-settings(string, int, bool, bool) -> string;
    callback test-provider(string, string);
    callback login-requested(string, string, string);
    callback logout-requested;
    callback manual-sync-requested;
    callback test-connection-requested;
    callback revoke-device-requested(string);
    callback regenerate-device-identity-requested;
    callback export-data-requested;
    callback import-data-requested;
    callback check-update-requested;
    callback update-global-hotkey(string) -> string;
    callback update-start-at-login(bool) -> string;
    callback update-launch-minimized(bool) -> string;

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: root.sidebar-collapsed ? 60px : 204px;
            background: #f3f3f3;
            border-width: 0px;
            animate width { duration: 180ms; easing: ease-out-quad; }

            VerticalLayout {
                padding-left: 7px;
                padding-right: 7px;
                padding-top: 10px;
                padding-bottom: 12px;
                spacing: 5px;

                Rectangle {
                    height: 46px;
                    HorizontalLayout {
                        padding-left: 11px;
                        spacing: 11px;
                        Rectangle {
                            width: 28px;
                            height: 46px;
                            background: transparent;
                            Image {
                                width: 28px;
                                height: 28px;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("icons/logo.svg");
                                image-fit: contain;
                            }
                        }
                        if !root.sidebar-collapsed: VerticalLayout {
                            spacing: 0px;
                            Text { text: "LVOS"; color: #202020; font-size: 17px; font-weight: 600; vertical-alignment: bottom; }
                            Text { text: "Vocabulary workspace"; color: #777777; font-size: 9px; vertical-alignment: top; }
                        }
                    }
                }

                Rectangle {
                    height: 38px;
                    border-radius: 5px;
                    background: menu-touch.has-hover ? #e8e8e8 : transparent;
                    Image {
                        x: 15px;
                        y: 9px;
                        width: 20px;
                        height: 20px;
                        source: @image-url("icons/menu.svg");
                        colorize: #4f5b66;
                        image-fit: contain;
                    }
                    menu-touch := TouchArea { clicked => { root.sidebar-collapsed = !root.sidebar-collapsed; } }
                }

                FluentSidebarItem {
                    icon: @image-url("icons/history.svg");
                    label: "History";
                    selected: root.active-page == 0;
                    collapsed: root.sidebar-collapsed;
                    accent: #0078d4;
                    activated => { root.active-page = 0; }
                }
                FluentSidebarItem {
                    icon: @image-url("icons/star.svg");
                    label: "Favorites";
                    selected: root.active-page == 1;
                    collapsed: root.sidebar-collapsed;
                    accent: #d97706;
                    activated => { root.active-page = 1; }
                }

                Rectangle { vertical-stretch: 1; }

                if !root.sidebar-collapsed: Rectangle {
                    height: 58px;
                    border-radius: 7px;
                    background: #e9f3fb;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 9px;
                        IconSlot { width: 18px; height: 38px; icon: @image-url("icons/shield.svg"); icon-size: 18px; icon-color: #107c10; }
                        VerticalLayout {
                            spacing: 1px;
                            Text { text: "Local-first"; color: #274b35; font-size: 11px; font-weight: 600; }
                            Text { text: "History stays on this device"; color: #52705c; font-size: 9px; }
                        }
                    }
                }

                Rectangle { height: 1px; background: #dedede; }
                FluentSidebarItem {
                    icon: @image-url("icons/settings.svg");
                    label: "Settings";
                    selected: root.active-page == 2;
                    collapsed: root.sidebar-collapsed;
                    accent: #5b5fc7;
                    activated => { root.active-page = 2; }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: #fbfbfb;
            border-radius: 12px;
            border-width: 1px;
            border-color: #e5e5e5;

            if root.active-page == 0: VerticalLayout {
                padding: 22px;
                spacing: 13px;
                HorizontalLayout {
                    PageHeader { title: "History"; subtitle: "Your private lookup timeline, stored only on this device."; }
                    Rectangle { horizontal-stretch: 1; }
                    StatusChip { text: root.history-records.length + " entries"; good: root.history-records.length > 0; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    SearchBox {
                        horizontal-stretch: 1;
                        placeholder: "Search English or Chinese…";
                        text <=> root.search-text;
                        edited(value) => { root.history-search(value); }
                    }
                    ToolbarButton {
                        icon: @image-url("icons/trash.svg");
                        label: "Clear history";
                        danger: true;
                        activated => { root.clear-history-requested(); }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 9px;
                        for item[index] in root.history-records: RecordCard {
                            item: item;
                            favorite-toggled(key) => { root.favorite-toggled(key, item.favorite); }
                        }
                        if root.history-records.length == 0: Rectangle {
                            height: 240px;
                            border-radius: 8px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #e1e4e8;
                            VerticalLayout {
                                alignment: center;
                                spacing: 12px;
                                Rectangle {
                                    height: 48px;
                                    HorizontalLayout {
                                        alignment: center;
                                        IconSlot { width: 48px; height: 48px; icon: @image-url("icons/history.svg"); icon-size: 42px; icon-color: #8bb8dc; }
                                    }
                                }
                                Text { text: "No lookups yet"; color: #303030; font-size: 16px; font-weight: 600; horizontal-alignment: center; }
                                Text { text: "Select English text and press your global shortcut to begin."; color: #777777; font-size: 12px; horizontal-alignment: center; }
                            }
                        }
                    }
                }
            }

            if root.active-page == 1: VerticalLayout {
                padding: 22px;
                spacing: 13px;
                HorizontalLayout {
                    PageHeader { title: "Favorites"; subtitle: "A focused vocabulary collection that remains available offline."; }
                    Rectangle { horizontal-stretch: 1; }
                    StatusChip { text: root.favorite-records.length + " saved"; good: root.favorite-records.length > 0; }
                }
                SearchBox {
                    placeholder: "Search favorites…";
                    text <=> root.search-text;
                    edited(value) => { root.favorites-search(value); }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 9px;
                        for item[index] in root.favorite-records: RecordCard {
                            item: item;
                            favorite-toggled(key) => { root.favorite-toggled(key, true); }
                        }
                        if root.favorite-records.length == 0: Rectangle {
                            height: 240px;
                            border-radius: 8px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #e1e4e8;
                            VerticalLayout {
                                alignment: center;
                                spacing: 12px;
                                Rectangle {
                                    height: 48px;
                                    HorizontalLayout {
                                        alignment: center;
                                        IconSlot { width: 48px; height: 48px; icon: @image-url("icons/star.svg"); icon-size: 42px; icon-color: #d9a441; }
                                    }
                                }
                                Text { text: "Nothing saved yet"; color: #303030; font-size: 16px; font-weight: 600; horizontal-alignment: center; }
                                Text { text: "Use the star action on a lookup to keep it here."; color: #777777; font-size: 12px; horizontal-alignment: center; }
                            }
                        }
                    }
                }
            }

            if root.active-page == 2: VerticalLayout {
                padding: 22px;
                spacing: 13px;
                PageHeader { title: "Settings"; subtitle: "Configure desktop behavior, translation, synchronization, and data."; }
                HorizontalLayout {
                    spacing: 14px;
                    Rectangle {
                        width: 172px;
                        border-radius: 8px;
                        background: #f7f7f7;
                        border-width: 1px;
                        border-color: #e1e4e8;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 3px;
                            SettingsSidebarItem { icon: @image-url("icons/general.svg"); label: "General"; selected: root.settings-page == 0; activated => { root.settings-page = 0; } }
                            SettingsSidebarItem { icon: @image-url("icons/translate.svg"); label: "Translation"; selected: root.settings-page == 1; activated => { root.settings-page = 1; } }
                            SettingsSidebarItem { icon: @image-url("icons/account.svg"); label: "Account"; selected: root.settings-page == 2; activated => { root.settings-page = 2; } }
                            SettingsSidebarItem { icon: @image-url("icons/sync.svg"); label: "Sync"; selected: root.settings-page == 3; activated => { root.settings-page = 3; } }
                            SettingsSidebarItem { icon: @image-url("icons/devices.svg"); label: "Devices"; selected: root.settings-page == 4; activated => { root.settings-page = 4; } }
                            SettingsSidebarItem { icon: @image-url("icons/history.svg"); label: "History"; selected: root.settings-page == 5; activated => { root.settings-page = 5; } }
                            SettingsSidebarItem { icon: @image-url("icons/data.svg"); label: "Data"; selected: root.settings-page == 6; activated => { root.settings-page = 6; } }
                            SettingsSidebarItem { icon: @image-url("icons/update.svg"); label: "Update"; selected: root.settings-page == 7; activated => { root.settings-page = 7; } }
                            Rectangle { vertical-stretch: 1; }
                            Text { text: "LVOS 0.1.5"; color: #929292; font-size: 9px; horizontal-alignment: center; }
                        }
                    }

                    ScrollView {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            spacing: 14px;

                            if root.settings-page == 0: VerticalLayout {
                                spacing: 14px;
                                PageHeader { title: "General"; subtitle: "Desktop behavior and network defaults."; }
                                FluentCard {
                                    card-height: 420px;
                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 11px;
                                        Text { text: "Global shortcut"; color: #303030; font-size: 13px; font-weight: 600; }
                                        Text { text: "Press this shortcut after selecting English text in another app."; color: #777777; font-size: 11px; }
                                        hotkey := LineEdit { text <=> root.global-hotkey; }
                                        HorizontalLayout { alignment: end; Button { text: "Save shortcut"; clicked => { root.settings-error = root.update-global-hotkey(hotkey.text); } } }
                                        Rectangle { height: 1px; background: #ececec; }
                                        login-start := Switch { text: "Start LVOS when I sign in"; checked <=> root.start-at-login; toggled => { root.settings-error = root.update-start-at-login(self.checked); } }
                                        minimized := Switch { text: "Launch minimized to the system tray"; checked <=> root.launch-minimized; toggled => { root.settings-error = root.update-launch-minimized(self.checked); } }
                                        Rectangle { height: 1px; background: #ececec; }
                                        Text { text: "Network proxy"; color: #303030; font-size: 13px; font-weight: 600; }
                                        HorizontalLayout {
                                            spacing: 10px;
                                            proxy-type := ComboBox { width: 150px; model: ["HTTP", "SOCKS5"]; current-index <=> root.proxy-kind; }
                                            proxy-address := LineEdit { horizontal-stretch: 1; text <=> root.proxy-address; placeholder-text: "127.0.0.1:7890"; }
                                            Button { text: "Save network"; clicked => { root.settings-error = root.persist-network-settings(proxy-address.text, proxy-type.current-index, root.provider-proxy-enabled, root.update-proxy-enabled); } }
                                        }
                                        if root.settings-error != "": Text { text: root.settings-error; color: #a4262c; font-size: 11px; wrap: word-wrap; }
                                    }
                                }
                            }

                            if root.settings-page == 1: VerticalLayout {
                                spacing: 14px;
                                PageHeader { title: "Translation"; subtitle: "Tencent TokenHub model and your private credential."; }
                                FluentCard {
                                    card-height: 330px;
                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            Text { text: "Tencent TokenHub"; color: #303030; font-size: 14px; font-weight: 600; }
                                            Rectangle { horizontal-stretch: 1; }
                                            StatusChip { text: root.tokenhub-configured ? "Configured" : "Setup required"; good: root.tokenhub-configured; }
                                        }
                                        Text { text: "Model"; color: #555555; font-size: 12px; }
                                        tokenhub-model := LineEdit { text <=> root.tokenhub-model; placeholder-text: "hy-mt2-lite"; }
                                        Text { text: "API key"; color: #555555; font-size: 12px; }
                                        tokenhub-key := LineEdit { placeholder-text: "Stored securely in Windows Credential Manager"; input-type: InputType.password; }
                                        provider-proxy := Switch { text: "Use the configured proxy for provider requests"; checked <=> root.provider-proxy-enabled; }
                                        if root.settings-error != "": Text { text: root.settings-error; color: #a4262c; font-size: 11px; }
                                        HorizontalLayout {
                                            alignment: end;
                                            spacing: 8px;
                                            Button { text: "Test connection"; clicked => { root.test-provider(tokenhub-model.text, tokenhub-key.text); } }
                                            Button { text: "Save"; clicked => {
                                                root.settings-error = root.validate-provider-settings(tokenhub-model.text, tokenhub-key.text);
                                                if root.settings-error == "" { root.persist-provider-settings(tokenhub-model.text, tokenhub-key.text, provider-proxy.checked); tokenhub-key.text = ""; }
                                            } }
                                        }
                                    }
                                }
                            }

                            if root.settings-page == 2: VerticalLayout {
                                spacing: 14px;
                                PageHeader { title: "Account"; subtitle: "Sign in only when you want private cross-device synchronization."; }
                                FluentCard {
                                    card-height: 350px;
                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 10px;
                                        Text { text: "Server URL"; color: #555555; font-size: 12px; }
                                        server := LineEdit { text: root.server-url; }
                                        Text { text: "Username"; color: #555555; font-size: 12px; }
                                        user := LineEdit { text: root.username; }
                                        Text { text: "Password"; color: #555555; font-size: 12px; }
                                        password := LineEdit { input-type: InputType.password; placeholder-text: "Never stored"; }
                                        HorizontalLayout { alignment: end; spacing: 8px; Button { text: "Sign out"; clicked => { root.logout-requested(); } } Button { text: "Sign in"; clicked => { root.login-requested(server.text, user.text, password.text); } } }
                                        Rectangle { height: 1px; background: #ececec; }
                                        Button { text: "Replace revoked device identity…"; clicked => { root.regenerate-device-identity-requested(); } }
                                    }
                                }
                            }

                            if root.settings-page == 3: VerticalLayout {
                                spacing: 14px;
                                PageHeader { title: "Sync"; subtitle: "Inspect the current profile and request synchronization."; }
                                FluentCard {
                                    card-height: 230px;
                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 13px;
                                        HorizontalLayout { Text { text: "Status"; color: #666666; } Rectangle { horizontal-stretch: 1; } StatusChip { text: root.sync-status; good: root.sync-status == "Connected"; } }
                                        HorizontalLayout { Text { text: "Server"; color: #666666; } Rectangle { horizontal-stretch: 1; } Text { text: root.server-url; color: #303030; } }
                                        HorizontalLayout { Text { text: "Current device"; color: #666666; } Rectangle { horizontal-stretch: 1; } Text { text: root.current-device; color: #303030; } }
                                        Rectangle { height: 1px; background: #ececec; }
                                        HorizontalLayout { alignment: end; spacing: 8px; Button { text: "Test connection"; clicked => { root.test-connection-requested(); } } Button { text: "Sync now"; clicked => { root.manual-sync-requested(); } } }
                                    }
                                }
                            }

                            if root.settings-page == 4: VerticalLayout {
                                spacing: 12px;
                                PageHeader { title: "Devices"; subtitle: "Review and revoke installations associated with this account."; }
                                for device[index] in root.devices: Rectangle {
                                    height: 76px;
                                    border-radius: 8px;
                                    background: #ffffff;
                                    border-width: 1px;
                                    border-color: #e1e4e8;
                                    HorizontalLayout {
                                        padding: 14px;
                                        spacing: 12px;
                                        IconSlot { width: 24px; height: 48px; icon: @image-url("icons/devices.svg"); icon-size: 24px; icon-color: device.current ? #0067c0 : #667085; }
                                        VerticalLayout { spacing: 4px; Text { text: device.name + (device.current ? "  ·  Current" : ""); color: #303030; font-weight: 600; } Text { text: device.platform + "  ·  " + device.last-seen; color: #777777; font-size: 11px; } }
                                        Button { text: device.revoked ? "Revoked" : "Revoke"; enabled: !device.revoked; clicked => { root.revoke-device-requested(device.id); } }
                                    }
                                }
                                if root.devices.length == 0: FluentCard { card-height: 120px; Text { text: "No synchronized devices to display."; color: #777777; horizontal-alignment: center; vertical-alignment: center; } }
                            }

                            if root.settings-page == 5: VerticalLayout {
                                spacing: 14px;
                                PageHeader { title: "History"; subtitle: "Manage the private lookup cache on this device."; }
                                FluentCard {
                                    card-height: 170px;
                                    HorizontalLayout {
                                        padding: 20px;
                                        spacing: 16px;
                                        IconSlot { width: 28px; height: 130px; icon: @image-url("icons/trash.svg"); icon-size: 28px; icon-color: #c42b1c; }
                                        VerticalLayout { spacing: 5px; Text { text: "Clear local history"; color: #303030; font-size: 14px; font-weight: 600; } Text { text: "Favorites and their learning statistics are preserved."; color: #777777; font-size: 11px; } }
                                        Button { text: "Clear history"; clicked => { root.clear-history-requested(); } }
                                    }
                                }
                            }

                            if root.settings-page == 6: VerticalLayout {
                                spacing: 14px;
                                PageHeader { title: "Data"; subtitle: "Move your vocabulary without exporting secrets or device identity."; }
                                FluentCard {
                                    card-height: 190px;
                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 12px;
                                        Text { text: "Portable archive"; color: #303030; font-size: 14px; font-weight: 600; }
                                        Text { text: "Includes history and favorites. Credentials, sessions, and installation identity are excluded."; color: #777777; font-size: 11px; wrap: word-wrap; }
                                        HorizontalLayout { alignment: end; spacing: 8px; Button { text: "Import data"; clicked => { root.import-data-requested(); } } Button { text: "Export data"; clicked => { root.export-data-requested(); } } }
                                    }
                                }
                            }

                            if root.settings-page == 7: VerticalLayout {
                                spacing: 14px;
                                PageHeader { title: "Update"; subtitle: "Check the signed manifest and open the official release page."; }
                                FluentCard {
                                    card-height: 230px;
                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 13px;
                                        HorizontalLayout { IconSlot { width: 22px; height: 28px; icon: @image-url("icons/update.svg"); icon-size: 22px; icon-color: #0067c0; } Text { text: root.update-status; color: #303030; font-size: 13px; vertical-alignment: center; } }
                                        update-proxy := Switch { text: "Use the configured proxy for update checks"; checked <=> root.update-proxy-enabled; }
                                        Rectangle { height: 1px; background: #ececec; }
                                        HorizontalLayout { alignment: end; spacing: 8px; Button { text: "Save network"; clicked => { root.settings-error = root.persist-network-settings(root.proxy-address, root.proxy-kind, root.provider-proxy-enabled, update-proxy.checked); } } Button { text: "Check for updates"; clicked => { root.check-update-requested(); } } }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

import { SurfaceCard, SettingRow, SectionHeader, FluentButton, EmptyState, UiConstants } from "@quadrant-kit";
import { DeviceRecord } from "../../model/ui_types.slint";

export component DevicesSettingsPage inherits VerticalLayout {
    in property <bool> interaction-enabled: true;
    in property <[DeviceRecord]> devices;
    private property <int> focus-epoch;
    private property <string> focus-device;
    public function restore-focus(id: string) { root.focus-device = id; root.focus-epoch += 1; }

    callback revoke-device-requested(string);


    spacing: UiConstants.space_12;
    vertical-stretch: 0;
    SectionHeader { title: "Devices"; description: "Review installations associated with this account."; }
    for device in root.devices: SurfaceCard {
        in property <int> requested-focus: root.focus-epoch;
        changed requested-focus => { if device.id == root.focus-device && !device.revoked && root.interaction-enabled { revoke.focus(); } }
        VerticalLayout {
            padding: UiConstants.space_20;
            SettingRow {
                title: device.name + (device.current ? " · Current" : "");
                description: device.platform + " · " + device.last-seen;
                revoke := FluentButton { text: device.revoked ? "Revoked" : "Revoke"; danger: !device.revoked; enabled: root.interaction-enabled && !device.revoked;
                    clicked => { root.revoke-device-requested(device.id); }
                }
            }
        }
    }
    if root.devices.length == 0: EmptyState {
        title: "No synchronized devices"; message: "Sign in to review devices associated with your account.";
        icon: @image-url("../../icons/devices.svg");
    }
}

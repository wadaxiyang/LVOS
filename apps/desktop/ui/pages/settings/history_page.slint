import { SurfaceCard, SettingRow, SectionHeader, FluentButton, FluentIcons, UiConstants } from "@quadrant-kit";

export component HistorySettingsPage inherits VerticalLayout {
    in property <bool> interaction-enabled: true;


    callback clear-history-requested;


    spacing: UiConstants.space_12;
    vertical-stretch: 0;
    SectionHeader { title: "History"; description: "Manage the private lookup cache on this device."; }
    SurfaceCard {
        VerticalLayout {
            padding: UiConstants.space_20;
            SettingRow { title: "Clear local history"; description: "Favorites and their learning statistics are preserved.";
                FluentButton { enabled: root.interaction-enabled; text: "Clear history"; icon: FluentIcons.delete; danger: true; clicked => { root.clear-history-requested(); } }
            }
        }
    }
}

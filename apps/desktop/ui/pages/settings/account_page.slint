import { SurfaceCard, SettingRow, SectionHeader, FluentButton, FluentTextField, Theme, Typography, UiConstants } from "@quadrant-kit";
import { LineEdit } from "std-widgets.slint"; // S4: the two remaining credential fields.

export component AccountSettingsPage inherits VerticalLayout {
    in property <string> server-url: "https://lvos.niuniu770.site";
    in property <string> username;

    callback login-requested(string, string, string);
    callback logout-requested;
    callback regenerate-device-identity-requested;

    in property <bool> section-visible;
    changed section-visible => { if !root.section-visible { password.text = ""; } }

    spacing: UiConstants.space_12;
    vertical-stretch: 0;
    SectionHeader { title: "Account"; description: "Sign in for private cross-device synchronization."; }
    SurfaceCard {
        VerticalLayout {
            padding: UiConstants.space_20;
            spacing: UiConstants.space_12;
            Text { text: "Server URL"; color: Theme.text_primary; font-size: Typography.body; }
            server := FluentTextField { text: root.server-url; accessible-role: groupbox; accessible-label: "Server URL"; }
            Text { text: "Username"; color: Theme.text_primary; font-size: Typography.body; }
            user := FluentTextField { text: root.username; accessible-role: groupbox; accessible-label: "Username"; }
            Text { text: "Password"; color: Theme.text_primary; font-size: Typography.body; }
            password := LineEdit { input-type: InputType.password; placeholder-text: "Never stored"; accessible-label: "Account password"; }
            HorizontalLayout { alignment: end; spacing: UiConstants.space_12;
                FluentButton { text: "Sign out"; clicked => { root.logout-requested(); } }
                FluentButton { text: "Sign in"; primary: true; clicked => { root.login-requested(server.text, user.text, password.text); } }
            }
            SettingRow { title: "Device identity"; description: "Replace this installation's identity if it has been revoked."; }
            HorizontalLayout { alignment: end;
                FluentButton { text: "Replace revoked device identity…"; clicked => { root.regenerate-device-identity-requested(); } }
            }
        }
    }
}

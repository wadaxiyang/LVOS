import { SurfaceCard, SettingRow, SectionHeader, FluentButton, FluentTextField, FluentSwitch, FluentComboBox, UiConstants } from "@quadrant-kit";
import { FeedbackKind } from "../../model/ui_types.slint";

export component GeneralSettingsPage inherits VerticalLayout {
    in property <bool> interaction-enabled: true;
    public function restore-focus() { hotkey.focus(); }
    in-out property <int> proxy-kind: 0;
    in-out property <string> proxy-address;
    in-out property <bool> provider-proxy-enabled: false;
    in-out property <bool> update-proxy-enabled: false;
    in-out property <string> global-hotkey: "⌥D";
    in-out property <bool> start-at-login;
    in-out property <bool> launch-minimized;
    in-out property <int> popup-idle-timeout-index: 2;

    callback persist-network-settings(string, int, bool, bool);
    callback update-global-hotkey(string);
    callback update-start-at-login(bool);
    callback update-launch-minimized(bool);
    callback update-popup-idle-timeout(int);

    callback feedback(string, FeedbackKind);
    changed global-hotkey => { hotkey.text = root.global-hotkey; }

    spacing: UiConstants.space_12;
    vertical-stretch: 0;
    SectionHeader { title: "General"; description: "Desktop behavior and network defaults."; }
    SurfaceCard {
        VerticalLayout {
            padding: UiConstants.space_20;
            spacing: UiConstants.space_12;
            SettingRow { title: "Global shortcut"; description: "Use this shortcut after selecting text in another app."; }
            HorizontalLayout {
                spacing: UiConstants.space_12;
                hotkey := FluentTextField { enabled: root.interaction-enabled; horizontal-stretch: 1; text: root.global-hotkey; accessible-role: groupbox; accessible-label: "Global shortcut"; }
                FluentButton { enabled: root.interaction-enabled; text: "Save shortcut"; clicked => {
                    let draft = hotkey.text;
                    root.feedback("Saving shortcut…", FeedbackKind.info);
                    root.update-global-hotkey(draft);
                } }
            }
            SettingRow {
                title: "Start at login"; description: "Open LVOS when you sign in to this computer.";
                FluentSwitch { enabled: root.interaction-enabled; checked <=> root.start-at-login; accessible-label: "Start at login"; toggled => {
                    root.feedback("Saving startup preference…", FeedbackKind.info);
                    root.update-start-at-login(self.checked);
                } }
            }
            SettingRow {
                title: "Launch minimized"; description: "Keep LVOS in the system tray on startup.";
                FluentSwitch { enabled: root.interaction-enabled; checked <=> root.launch-minimized; accessible-label: "Launch minimized"; toggled => {
                    root.feedback("Saving launch preference…", FeedbackKind.info);
                    root.update-launch-minimized(self.checked);
                } }
            }
            SettingRow {
                title: "Lookup popup idle retention";
                description: "Keep a closed lookup window briefly for faster repeated queries, then release its UI resources.";
                popup-retention := FluentComboBox {
                    enabled: root.interaction-enabled;
                    width: 176px;
                    model: ["Release immediately", "15 seconds", "30 seconds (default)", "60 seconds", "120 seconds"];
                    current-index <=> root.popup-idle-timeout-index;
                    accessible-label: "Lookup popup idle retention";
                    selected(value) => {
                        let selected-index = self.current-index;
                        root.feedback("Saving lookup popup retention…", FeedbackKind.info);
                        root.update-popup-idle-timeout(selected-index);
                    }
                }
            }
        }
    }
    SurfaceCard {
        VerticalLayout {
            padding: UiConstants.space_20;
            spacing: UiConstants.space_12;
            SettingRow {
                title: "Network proxy"; description: "Translation and update checks opt in separately below.";
                proxy-type := FluentComboBox { enabled: root.interaction-enabled; width: 120px; model: ["HTTP", "SOCKS5"]; current-index <=> root.proxy-kind; accessible-label: "Proxy type"; }
            }
            proxy-address := FluentTextField { enabled: root.interaction-enabled; text <=> root.proxy-address; placeholder_text: "127.0.0.1:7890"; accessible-role: groupbox; accessible-label: "Proxy address"; }
            HorizontalLayout { alignment: end;
                FluentButton { enabled: root.interaction-enabled; text: "Save network"; clicked => {
                    root.feedback("Saving network settings…", FeedbackKind.info);
                    root.persist-network-settings(proxy-address.text, proxy-type.current-index, root.provider-proxy-enabled, root.update-proxy-enabled);
                } }
            }
        }
    }
}

import { Palette } from "std-widgets.slint";
import { Theme, ThemeMode, Motion, Typography, UiConstants, PageHeader, FluentInfoBar, InfoBarKind, FluentButton, FluentScrollView } from "@quadrant-kit";

export component PermissionWindow inherits Window {
    title: "LVOS Permissions";
    icon: @image-url("../icons/logo.svg");
    width: 640px;
    height: 400px;
    background: Theme.background;
    // Globals belong to this Window instance. Keep the existing light policy.
    default-font-family: Theme.ui_font_family;
    // Host diagnostics can exercise each independent global context.
    in-out property <bool> dark-theme: false;
    in-out property <bool> reduce-motion: false;
    changed dark-theme => {
        Theme.mode = root.dark-theme ? ThemeMode.dark : ThemeMode.light;
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
    }
    changed reduce-motion => { Motion.reduced_motion = root.reduce-motion; }
    init => {
        Theme.mode = ThemeMode.light;
        Theme.system_dark = false;
        Theme.ui_font_family = "";
        Motion.animations_enabled = true;
        Motion.reduced_motion = false;
        Palette.color-scheme = ColorScheme.light;
    }

    in-out property <string> status-text: "Accessibility permission is required.";
    callback open-settings;
    callback check-again;
    callback restart-requested;

    VerticalLayout {
        padding: UiConstants.space_24;
        spacing: UiConstants.space_16;
        PageHeader { title: "Permissions"; subtitle: "Allow LVOS to capture selected text."; }
        Text { text: "macOS requires Accessibility permission before LVOS can send Cmd+C. LVOS only sends it after you press the configured global hotkey.";
            color: Theme.text_secondary; font-size: Typography.body; wrap: word-wrap;
        }
        FluentInfoBar { message: "Accessibility access"; kind: InfoBarKind.warning; closable: false; }
        FluentScrollView {
            horizontal-scrollbar-policy: always-off;
            viewport-width: self.visible-width;
            Text { width: parent.visible-width; text: root.status-text; color: Theme.text_primary; font-size: Typography.body; wrap: word-wrap; }
        }
        HorizontalLayout {
            alignment: end; spacing: UiConstants.space_12;
            FluentButton { text: "Open Accessibility Settings"; clicked => { root.open-settings(); } }
            FluentButton { text: "Check Again"; clicked => { root.check-again(); } }
            FluentButton { text: "Restart LVOS"; clicked => { root.restart-requested(); } }
        }
    }
}

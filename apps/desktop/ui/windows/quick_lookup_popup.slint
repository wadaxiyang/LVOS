import { Palette } from "std-widgets.slint";
import { Theme, ThemeMode, Motion, Typography, UiConstants, SurfaceCard, FluentIcon, IconButton, FluentProgressRing, FluentScrollView, FluentInfoBar, InfoBarKind } from "@quadrant-kit";

export component QuickLookupPopup inherits Window {
    title: "LVOS Lookup Card";
    icon: @image-url("../icons/logo.svg");
    width: root.popup-width;
    height: root.popup-height;
    background: transparent;
    always-on-top: true;
    no-frame: true;
    // Globals belong to this Window instance. Keep the existing light policy.
    default-font-family: Theme.ui_font_family;
    init => {
        Theme.mode = ThemeMode.light;
        Theme.system_dark = false;
        Theme.ui_font_family = "";
        Motion.animations_enabled = true;
        Motion.reduced_motion = false;
        Palette.color-scheme = ColorScheme.light;
    }

    in property <string> source-text;
    in property <string> translated-text;
    in property <string> error-title;
    in property <string> error-detail;
    in property <int> effective-count;
    in property <bool> favorite;
    in property <bool> loading;
    in property <bool> text-mode;
    in property <bool> error-visible;
    in property <length> popup-width: 360px;
    in property <length> popup-height: 220px;
    in-out property <int> native-request-id;
    in-out property <bool> native-show-requested;
    in-out property <bool> native-interactive;
    callback favorite-toggled;
    callback refresh-requested;
    callback interaction-started;
    callback dismiss-requested;

    SurfaceCard {
        VerticalLayout {
            padding: UiConstants.space_16;
            spacing: UiConstants.space_12;
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: UiConstants.space_12;
                FluentIcon { source: @image-url("../icons/translate.svg"); size: 24px; icon_color: Theme.accent; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text { text: root.source-text; color: Theme.text_primary; font-size: Typography.body; font-weight: Typography.semibold; overflow: elide; }
                    Text { text: "QUICK LOOKUP"; color: Theme.text_tertiary; font-size: Typography.caption; }
                }
                IconButton {
                    icon: root.favorite ? @image-url("../icons/star-filled.svg") : @image-url("../icons/star.svg");
                    tooltip: root.favorite ? "Remove from Favorites" : "Add to Favorites";
                    accessible_name: self.tooltip;
                    clicked => { root.interaction-started(); root.favorite-toggled(); }
                }
            }
            if root.loading: HorizontalLayout {
                spacing: UiConstants.space_12;
                FluentProgressRing { width: 24px; height: 24px; }
                Text { text: "Translating…"; color: Theme.text_secondary; font-size: Typography.body; vertical-alignment: center; }
            }
            if !root.loading: FluentScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                viewport-width: self.visible-width;
                VerticalLayout {
                    spacing: UiConstants.space_8;
                    if root.error-visible: FluentInfoBar { message: "Translation could not finish"; kind: InfoBarKind.error; closable: false; }
                    Text {
                        text: root.error-visible ? root.error-title + "\n" + root.error-detail : root.translated-text;
                        color: Theme.text_primary; font-size: Typography.body; wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                vertical-stretch: 0;
                alignment: space-between;
                Text { text: root.effective-count > 1 ? root.effective-count + " lookups" : ""; color: Theme.text_tertiary; font-size: Typography.caption; vertical-alignment: center; }
                IconButton { icon: @image-url("../icons/refresh.svg"); tooltip: "Refresh translation"; accessible_name: "Refresh translation";
                    clicked => { root.interaction-started(); root.refresh-requested(); }
                }
            }
        }
    }
}

import { Palette } from "std-widgets.slint";
import { Theme, ThemeMode, Motion, Typography, UiConstants, SurfaceCard, FluentIcon, IconButton, FluentProgressRing, FluentInfoBar, FluentTextArea, InfoBarKind } from "@quadrant-kit";

export component QuickLookupPopup inherits Window {
    title: "LVOS Lookup Card";
    icon: @image-url("../icons/logo.svg");
    width: root.popup-width;
    height: root.popup-height;
    background: transparent;
    always-on-top: true;
    no-frame: true;
    // Globals belong to this Window instance. Keep the existing light policy.
    default-font-family: Theme.ui_font_family;
    // Host diagnostics can exercise each independent global context.
    in-out property <bool> dark-theme: false;
    in-out property <bool> reduce-motion: false;
    changed dark-theme => {
        Theme.mode = root.dark-theme ? ThemeMode.dark : ThemeMode.light;
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
    }
    changed reduce-motion => { Motion.reduced_motion = root.reduce-motion; }
    init => {
        Theme.mode = ThemeMode.light;
        Theme.system_dark = false;
        Theme.ui_font_family = "";
        Motion.animations_enabled = true;
        Motion.reduced_motion = false;
        Palette.color-scheme = ColorScheme.light;
    }

    in property <string> source-text;
    in property <string> translated-text;
    in property <string> error-title;
    in property <string> error-detail;
    in property <int> effective-count;
    in property <bool> favorite;
    in property <bool> loading;
    in property <bool> text-mode;
    in property <bool> error-visible;
    in property <length> popup-width: 360px;
    in property <length> popup-height: 220px;
    private property <string> canonical-result: root.error-visible ? root.error-title + "\n" + root.error-detail : root.translated-text;
    private property <string> selectable-result: root.canonical-result;
    in-out property <int> native-request-id;
    in-out property <bool> native-show-requested;
    in-out property <bool> native-interactive;
    callback favorite-toggled;
    callback refresh-requested;
    callback copy-requested(string);
    callback interaction-started;
    callback dismiss-requested;
    changed canonical-result => { root.selectable-result = root.canonical-result; }

    SurfaceCard {
        VerticalLayout {
            padding: UiConstants.space_16;
            spacing: UiConstants.space_12;
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: UiConstants.space_12;
                FluentIcon { source: @image-url("../icons/translate.svg"); size: 24px; icon_color: Theme.accent; }
                Text {
                    horizontal-stretch: 1;
                    text: root.source-text;
                    color: Theme.text_primary;
                    font-size: Typography.body;
                    font-weight: Typography.semibold;
                    overflow: elide;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: root.favorite ? @image-url("../icons/star-filled.svg") : @image-url("../icons/star.svg");
                    tooltip: root.favorite ? "Remove from Favorites" : "Add to Favorites";
                    accessible_name: self.tooltip;
                    clicked => { root.interaction-started(); root.favorite-toggled(); }
                }
            }
            VerticalLayout {
                vertical-stretch: 1;
                if root.loading: HorizontalLayout {
                    spacing: UiConstants.space_12;
                    FluentProgressRing { width: 24px; height: 24px; indeterminate: !root.reduce-motion; progress: 0.75; running: !root.reduce-motion; }
                    Text { text: "Translating…"; color: Theme.text_secondary; font-size: Typography.body; vertical-alignment: center; }
                }
                if !root.loading && root.error-visible: FluentInfoBar { message: "Translation could not finish"; kind: InfoBarKind.error; closable: false; }
                result-editor := FluentTextArea {
                    visible: !root.loading;
                    vertical-stretch: 1;
                    text <=> root.selectable-result;
                    placeholder_text: "Translation";
                    edited(value) => {
                        // The public Kit control provides native selection/copy behavior. Restore
                        // the Provider result immediately so the display itself stays read-only.
                        root.selectable-result = root.canonical-result;
                        root.interaction-started();
                    }
                }
            }
            HorizontalLayout {
                vertical-stretch: 0;
                alignment: space-between;
                Text {
                    text: root.effective-count > 1 ? root.effective-count + " lookups" : "";
                    color: Theme.text_tertiary;
                    font-size: Typography.caption;
                    vertical-alignment: bottom;
                }
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: end;
                    spacing: UiConstants.space_8;
                    IconButton {
                        enabled: !root.loading && !root.error-visible && root.translated-text != "";
                        icon: @image-url("../icons/copy.svg");
                        tooltip: "Copy translation";
                        accessible_name: "Copy translation";
                        clicked => {
                            root.interaction-started();
                            root.copy-requested(root.translated-text);
                        }
                    }
                    IconButton {
                        enabled: !root.loading;
                        icon: @image-url("../icons/refresh.svg");
                        tooltip: "Refresh translation";
                        accessible_name: "Refresh translation";
                        clicked => { root.interaction-started(); root.refresh-requested(); }
                    }
                }
            }
        }
    }
}

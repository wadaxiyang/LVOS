# Internal project documentation is deliberately local-only, except for the
# renderer migration baseline and the public renderer architecture contract.
/AGENTS.md
/LVOS_development_spec.md
/docs/*
!/docs/architecture/
/docs/architecture/*
!/docs/architecture/RENDERER.md
!/docs/performance/
/docs/performance/*
!/docs/performance/SKIA_MIGRATION_BASELINE.md
/.firecrawl/

# Secrets and local configuration.
/.env
/.env.*
!/.env.example

# Rust and editor artifacts.
/target/
__pycache__/
*.py[cod]
**/*.rs.bk
.DS_Store
.idea/
.vscode/

# Local runtime data.
/data/
/backups/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.log
